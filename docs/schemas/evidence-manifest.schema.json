{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nullstate.dev/evidence-manifest.schema.json",
  "title": "nullstate evidence manifest",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "product",
    "product_version",
    "generated_at",
    "run",
    "artifact_count",
    "artifacts",
    "integrity",
    "signing"
  ],
  "properties": {
    "$schema": {
      "const": "https://schemas.nullstate.dev/evidence-manifest.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "product": {
      "const": "nullstate"
    },
    "product_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "run": {
      "type": "object",
      "required": [
        "id",
        "path",
        "scenario",
        "target",
        "offline"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string"
        },
        "scenario": {
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "offline": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "artifact_count": {
      "type": "integer",
      "minimum": 0
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    },
    "integrity": {
      "type": "object",
      "required": [
        "hash_algorithm",
        "workspace_included",
        "excluded_paths"
      ],
      "properties": {
        "hash_algorithm": {
          "const": "sha256"
        },
        "workspace_included": {
          "type": "boolean"
        },
        "excluded_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "signing": {
      "type": "object",
      "required": [
        "status",
        "algorithm",
        "signature",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "unsigned",
            "signed"
          ]
        },
        "algorithm": {
          "type": [
            "string",
            "null"
          ]
        },
        "key_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "signature": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
