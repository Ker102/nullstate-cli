{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nullstate.dev/eval-results.schema.json",
  "title": "Nullstate evaluation results",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "$schema",
    "schema_version",
    "generated_at",
    "suite",
    "case_count",
    "passed_count",
    "failed_count",
    "cases",
    "totals"
  ],
  "properties": {
    "$schema": {
      "const": "https://schemas.nullstate.dev/eval-results.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string"
    },
    "suite": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "case_count": {
      "type": "integer",
      "minimum": 0
    },
    "passed_count": {
      "type": "integer",
      "minimum": 0
    },
    "failed_count": {
      "type": "integer",
      "minimum": 0
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "duration_seconds",
          "summary",
          "metrics"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed"
            ]
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0
          },
          "summary": {
            "type": "object"
          },
          "metrics": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
