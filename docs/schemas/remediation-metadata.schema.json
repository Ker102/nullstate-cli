{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nullstate.dev/remediation-metadata.schema.json",
  "title": "Nullstate remediation metadata",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "$schema",
    "schema_version",
    "scenario",
    "changed",
    "changed_files",
    "ruleset_version",
    "rules_applied"
  ],
  "properties": {
    "$schema": {
      "const": "https://schemas.nullstate.dev/remediation-metadata.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "scenario": {
      "type": "string",
      "minLength": 1
    },
    "changed": {
      "type": "boolean"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ruleset_version": {
      "type": "string",
      "minLength": 1
    },
    "rules_applied": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
