{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nullstate.dev/external-agent-manifest.schema.json",
  "title": "Nullstate external agent manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "$schema",
    "schema_version",
    "agent",
    "runtime",
    "identities",
    "posture_evidence",
    "reachable_resources"
  ],
  "properties": {
    "$schema": {
      "const": "https://schemas.nullstate.dev/external-agent-manifest.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "agent": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "runtime": {
      "type": "object",
      "required": [
        "environment"
      ],
      "properties": {
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string"
        },
        "region": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "identities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "provider",
          "permissions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "agent",
              "delegated-user",
              "runtime",
              "tool",
              "workload"
            ]
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": true
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "posture_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "claim",
          "status",
          "evidence_class",
          "observed_at"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "unknown"
            ]
          },
          "evidence_class": {
            "enum": [
              "cryptographically-verified",
              "provider-observed",
              "operator-attested",
              "inferred",
              "unknown"
            ]
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "reachable_resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "provider",
          "data_classification",
          "actions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "data_classification": {
            "type": "string",
            "minLength": 1
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": true
      }
    }
  }
}
